# PhoneBeam coturn (development template)

# Copy to an untracked file (for example coturn.env) on the TURN host.
# Never commit a filled copy. Never put these values in the Android APK,
# the React bundle, or a pairing QR.

# coturn --use-auth-secret / TURN REST API
TURN_REALM=phonebeam.example
TURN_AUTH_SECRET=replace-with-a-long-random-secret

# URIs advertised by the coordinator (comma-separated)
# PHONEBEAM_TURN_URIS=turn:turn.example:3478?transport=udp,turn:turn.example:3478?transport=tcp,turns:turn.example:443?transport=tcp
# PHONEBEAM_TURN_SECRET=<same as TURN_AUTH_SECRET>
# PHONEBEAM_STUN_URIS=stun:stun.example:3478
# PHONEBEAM_ICE_TRANSPORT_POLICY=all
# PHONEBEAM_ICE_TRANSPORT_POLICY=relay   # force-TURN test only
