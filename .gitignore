# PhoneBeam — ignore build output, secrets, IDE, and OS files.
# Do not commit credentials, signing keys, or machine-specific config.

# --- Secrets and local environment ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
credentials.json
secrets.json
secrets/
**/local.properties
**/keystore.properties
**/secrets.properties
google-services.json
google-services.json.*
service-account*.json
*.secret
*.secrets

# --- Logs ---
*.log
logs/
log/

# --- OS ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- IDE / editor ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.code-workspace

# --- Android / Kotlin ---
.gradle/
**/build/
captures/
.cxx/
*.apk
*.aab
*.ap_
*.a_
*.dex
*.class
*.ap_
local.properties
*.hprof
.navigation/
*.externalNativeBuild
*.cxx
outputs/

# --- Node / React / TypeScript ---
node_modules/
dist/
dist-ssr/
.output/
.next/
.nuxt/
.turbo/
.cache/
.parcel-cache/
.eslintcache
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Go ---
bin/
vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# --- WebRTC / TURN / TLS material ---
*.crt
*.csr
*.der
coturn/
turnserver.conf

# --- Misc generated ---
tmp/
temp/
*.tmp
*.bak
*.orig
.direnv/
.vagrant/
